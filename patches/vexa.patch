diff --git a/core/meetings/modules/join/src/googlemeet/auth-guard.ts b/core/meetings/modules/join/src/googlemeet/auth-guard.ts
new file mode 100644
index 00000000..29f7f321
--- /dev/null
+++ b/core/meetings/modules/join/src/googlemeet/auth-guard.ts
@@ -0,0 +1,56 @@
+import type { Page } from "playwright";
+import { AdmissionError } from "../shared/admission";
+
+export class AuthSessionError extends AdmissionError {
+  constructor(message = "auth_required: Google sign-in required; owner must re-authenticate the browser profile") {
+    super("auth_session_missing", message);
+    this.name = "AuthSessionError";
+  }
+}
+
+export function throwIfGoogleAuthRedirect(page: Page): void {
+  let url: URL;
+  try { url = new URL(page.url()); } catch { return; }
+  // Never put the URL, path, query, account identity or page text in diagnostics.
+  if (url.hostname === "accounts.google.com") throw new AuthSessionError();
+}
+
+const ROOM_CODE = /^[a-z]{3}-[a-z]{4}-[a-z]{3}$/;
+
+/**
+ * Classify a Google Meet pathname. The room code itself is never returned, so
+ * this is safe to use in diagnostics.
+ *
+ * Measured against the live service on 2026-10-29: requesting
+ * `https://meet.google.com/<code>` is rewritten to
+ * `https://meet.google.com/meet/<code>` and STAYS there for the whole pre-join
+ * flow. Both shapes are therefore real room paths. Treating only `/<code>` as a
+ * room made every real lobby fail the guard and skip CTA resolution entirely,
+ * which surfaced as "Join now is visible but no selector matched".
+ */
+export function classifyMeetPath(pathname: string): "room" | "meet-room" | "landing" | "other" {
+  const path = pathname.replace(/\/+$/, "");
+  if (ROOM_CODE.test(path.slice(1))) return "room";
+  if (path.startsWith("/meet/") && ROOM_CODE.test(path.slice("/meet/".length))) return "meet-room";
+  if (path === "" || path === "/" || path === "/landing") return "landing";
+  return "other";
+}
+
+export function isMeetLobbyUrl(page: Page): boolean {
+  try {
+    const url = new URL(page.url());
+    if (url.protocol !== "https:" || url.hostname !== "meet.google.com") return false;
+    const kind = classifyMeetPath(url.pathname);
+    return kind === "room" || kind === "meet-room";
+  } catch { return false; }
+}
+
+/** True when the page is Meet but not a room path (home, landing, unknown route).
+ *  Used only to explain a join timeout; it never authorizes a click. */
+export function isMeetNonRoomUrl(page: Page): boolean {
+  try {
+    const url = new URL(page.url());
+    return url.protocol === "https:" && url.hostname === "meet.google.com" &&
+      classifyMeetPath(url.pathname) !== "room" && classifyMeetPath(url.pathname) !== "meet-room";
+  } catch { return false; }
+}
diff --git a/core/meetings/modules/join/src/googlemeet/auth-redirect.test.ts b/core/meetings/modules/join/src/googlemeet/auth-redirect.test.ts
