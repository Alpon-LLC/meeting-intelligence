+export function normalizeKeyterms(values: string[]): string[] {
+  if (values.length > MAX_KEYTERMS) throw new TypeError(`keyterms accepts at most ${MAX_KEYTERMS} entries`);
+  const result: string[] = [];
+  const seen = new Set<string>();
+  let estimatedTokens = 0;
+  for (const value of values) {
+    if (typeof value !== 'string') throw new TypeError('keyterms entries must be strings');
+    if (CONTROL_CHARACTER.test(value)) throw new TypeError('keyterms entries cannot contain control characters');
+    const term = value.trim().replace(/\s+/g, ' ');
+    if (!term) throw new TypeError('keyterms entries cannot be empty');
+    if (term.length < 2) throw new TypeError('keyterms entries must contain at least 2 characters');
+    if (term.length > MAX_KEYTERM_LENGTH) throw new TypeError(`keyterms entries cannot exceed ${MAX_KEYTERM_LENGTH} characters`);
+    const folded = term.toLocaleLowerCase('en-US');
+    if (!seen.has(folded)) {
+      const nextTokens = estimatedTokens + Math.max(1, Math.ceil(term.length / 4));
+      if (nextTokens > MAX_KEYTERM_TOKENS) throw new TypeError(`keyterms exceeds the ${MAX_KEYTERM_TOKENS}-token vocabulary budget`);
+      seen.add(folded);
+      estimatedTokens = nextTokens;
+      result.push(term);
+    }
+  }
