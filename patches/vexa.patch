+import { strict as assert } from 'assert';
+import { TranscriptionClient, normalizeKeyterms } from './transcription-client.js';
+
+async function main() {
+  assert.deepEqual(normalizeKeyterms([' MeetingLab ', 'meetinglab', 'Nova   Three']), ['MeetingLab', 'Nova Three']);
+  for (const invalid of [[''], ['x'], ['line\nbreak'], ['x'.repeat(81)], Array(101).fill('term')]) {
+    assert.throws(() => normalizeKeyterms(invalid), TypeError);
+  }
+  const fetch = globalThis.fetch;
+  const bodies: string[] = [];
+  globalThis.fetch = async (_url, init) => {
+    bodies.push(Buffer.from(init!.body as Buffer).toString('utf8'));
+    return new Response(JSON.stringify({ text: 'ok', language: 'en', duration: 0.1, segments: [] }));
+  };
+  try {
+    await new TranscriptionClient({ serviceUrl: 'https://stt.invalid', model: 'nova-3',
+      keyterms: ['MeetingLab', 'Hermes', 'meetinglab'] }).transcribe(new Float32Array(160));
+    const values = Array.from(bodies[0].matchAll(/name="keyterm"\r\n\r\n([^\r]+)\r\n/g), match => match[1]);
+    assert.deepEqual(values, ['MeetingLab', 'Hermes']);
+    assert.match(bodies[0], /name="model"\r\n\r\nnova-3\r\n/);
+    await new TranscriptionClient({ serviceUrl: 'https://stt.invalid' }).transcribe(new Float32Array(160));
+    assert.ok(!bodies[1].includes('name="keyterm"'));
+    console.log('PASS keyterms: normalization, rejection bounds, repeated multipart fields, model and empty control');
+  } finally { globalThis.fetch = fetch; }
+}
+main().catch(error => { console.error(error); process.exit(1); });
