+++ b/core/meetings/modules/join/src/googlemeet/auth-redirect.test.ts
@@ -0,0 +1,57 @@
+import { strict as assert } from 'assert';
+import { joinGoogleMeeting, waitForLobbyCta } from './join';
+import { waitForGoogleMeetingAdmission } from './admission';
+import { AuthSessionError, isMeetLobbyUrl, classifyMeetPath } from './auth-guard';
+import { googleAuthJoinCtaSelectors } from './selectors';
+
+async function main() {
+  let clicks = 0;
+  const redirect = 'https://accounts.google.com/v3/signin/confirmidentifier?secret=must-not-appear';
+  const page: any = {
+    url: () => redirect, goto: async () => {}, screenshot: async () => {},
+    bringToFront: async () => {}, waitForTimeout: async () => {},
+    locator: () => ({ first: () => ({ isVisible: async () => true,
+      elementHandle: async () => ({ click: async () => { clicks++; } }) }) }),
+  };
+  const authError = (error: any) => error instanceof AuthSessionError &&
+    error.outcome === 'auth_session_missing' && !error.message.includes('secret') && !error.message.includes('https:');
+  for (const authenticated of [true, false]) {
+    await assert.rejects(joinGoogleMeeting(page, 'https://meet.google.com/abc-defg-hij', 'Bot',
+      { authenticated, platform: 'google_meet' } as any), authError);
+  }
+  await assert.rejects(waitForLobbyCta(page, googleAuthJoinCtaSelectors, 1000, 'CTA'), authError);
+  await assert.rejects(waitForGoogleMeetingAdmission(page, 1000, {} as any), authError);
+  assert.equal(clicks, 0);
+  assert.equal(isMeetLobbyUrl(page), false);
+  page.url = () => 'https://meet.google.com/abc-defg-hij?hl=en';
+  assert.equal(isMeetLobbyUrl(page), true);
+  // Meet serves and keeps `/meet/<code>` (measured live 2026-10-29).
+  page.url = () => 'https://meet.google.com/meet/abc-defg-hij?authuser=0';
+  assert.equal(isMeetLobbyUrl(page), true);
+  assert.equal(classifyMeetPath('/meet/abc-defg-hij'), 'meet-room');
+  assert.equal(classifyMeetPath('/abc-defg-hij/'), 'room');
+  for (const path of ['/', '/landing', '/abc-defg-hij/extra', '/meet/', '/meet/abc-defg', '/meet/abc-defg-hij/x']) {
+    assert.equal(classifyMeetPath(path), path === '/' || path === '/landing' ? 'landing' : 'other', path);
+  }
+  // A generic jsname+span button on Meet without positive lobby controls is not
+  // an admission CTA, even though the old selector would have matched it.
+  page.evaluate = async () => ({ lang: 'en', nav: 'en-US' });
+  page.locator = (selector: string) => ({ filter() { return this; }, first: () => ({
+    isVisible: async () => selector === 'button[jsname]:not([aria-label]):has(span)',
+    elementHandle: async () => ({ click: async () => { clicks++; } }),
+  }) });
+  await assert.rejects(waitForLobbyCta(page, ['button[jsname]:not([aria-label]):has(span)'], 0, 'CTA'));
+  assert.equal(clicks, 0);
+
+  // Redirect after the initial admission check, in the no-lobby polling loop.
+  let reads = 0;
+  page.url = () => ++reads === 1 ? 'https://meet.google.com/abc-defg-hij' : redirect;
+  page.evaluate = async () => false;
+  page.$ = async () => null;
+  page.frames = () => [];
+  page.locator = () => ({ count: async () => 0, first: () => ({ isVisible: async () => false }) });
+  await assert.rejects(waitForGoogleMeetingAdmission(page, 1000, {} as any), authError);
+  assert.ok(reads >= 2);
+  console.log('Google auth redirect: fail-fast before clicks and during admission; sanitized terminal verdict');
+}
+main().catch(error => { console.error(error); process.exit(1); });
