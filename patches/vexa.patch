+/** Synthetic DOM regression, NOT a captured Google DOM or a live join witness.
+ * Run explicitly with a locally installed Chromium: PLAYWRIGHT_CHROMIUM_EXECUTABLE=…
+ * pnpm --filter @vexa/join exec tsx src/googlemeet/lobby-browser.test.ts
+ */
+import { strict as assert } from 'assert';
+import { chromium } from 'playwright';
+import { waitForLobbyCta, describeSelectorMiss } from './join';
+import { isMeetLobbyUrl } from './auth-guard';
+import { googleAuthJoinCtaSelectors } from './selectors';
+
+async function main() {
+  const browser = await chromium.launch({
+    executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE || undefined,
+  });
+  try {
+    const page = await browser.newPage();
+    // All navigation is fulfilled locally. No Google traffic, cookies or joins.
+    await page.route('**/*', route => route.fulfill({ contentType: 'text/html', body: '<html lang="en"><body></body></html>' }));
+    await page.goto('https://meet.google.com/abc-defg-hij?secret=do-not-log');
+    await page.setContent(`<button hidden jsname="old"><span>Join now</span></button>
+      <button data-is-muted="true" aria-label="Microphone">mic</button>
+      <button id="join" jsname="current"><span>Join now</span></button>`);
+    const selector = googleAuthJoinCtaSelectors[0];
+    assert.equal(isMeetLobbyUrl(page), true);
+    assert.equal(await page.locator(selector).count(), 2);
+    assert.equal(await page.locator(selector).first().isVisible(), false);
+    assert.equal(await page.locator(selector).nth(1).isVisible(), true);
+    console.log('RED mechanism: guard=true, matches=2, firstVisible=false, secondVisible=true');
+    const hit = await waitForLobbyCta(page, googleAuthJoinCtaSelectors, 0, 'join CTA');
+    assert.equal(await hit.handle.getAttribute('id'), 'join');
+    assert.equal(hit.selector, selector);
+    console.log('PASS hidden-first duplicate: same ordered selector resolves visible CTA');
+
+    // An earlier broad candidate must not beat the exact selector.
+    await page.setContent(`<button data-is-muted="true">mic</button>
+      <button jsname="wrong"><span>Other ways to join</span></button>
+      <button id="exact"><span>Join now</span></button>`);
+    const exact = await waitForLobbyCta(page, googleAuthJoinCtaSelectors, 0, 'join CTA');
+    assert.equal(await exact.handle.getAttribute('id'), 'exact');
+    console.log('PASS selector priority: exact before broad');
+
+    // Evidence for role-only controls is diagnostic, not authorization to click.
+    await page.setContent('<div role="button">Join now</div><button hidden>Join now</button>');
+    const diagnostic = await describeSelectorMiss(page, googleAuthJoinCtaSelectors, 0, 'join CTA', ['private participant']);
+    assert.match(diagnostic, /meetLobbyUrl=true/);
+    assert.match(diagnostic, /pathname=\/<room>/);
+    assert.match(diagnostic, /"matches":1/);
+    assert.match(diagnostic, /"firstVisible":false/);
+    assert.match(diagnostic, /"tag":"button"/);
+    assert.match(diagnostic, /"visibleRoleButtons":1/);
+    for (const secret of ['abc-defg-hij', 'secret', 'do-not-log', 'private participant']) assert.ok(!diagnostic.includes(secret));
+    console.log(diagnostic);
+    console.log('PASS sanitized diagnostics: path/guard/counts/tag/role/hidden-first, no text/query/room code');
+    // Live-measured production URL shape (2026-10-29): Meet serves every pre-join
+    // room as `/meet/<code>` and keeps it there. Treating that as a non-room made
+    // the guard skip CTA resolution on a real lobby — the Windmill no-join.
+    for (const url of [
+      'https://meet.google.com/meet/abc-defg-hij?authuser=0&secret=do-not-log',
+      'https://meet.google.com/meet/abc-defg-hij/',
+    ]) {
+      await page.goto(url);
+      await page.setContent('<button data-is-muted="true">mic</button><button id="served"><span>Join now</span></button>');
+      assert.equal(isMeetLobbyUrl(page), true);
+      const served = await waitForLobbyCta(page, googleAuthJoinCtaSelectors, 0, 'join CTA');
+      assert.equal(await served.handle.getAttribute('id'), 'served');
+      const diagnostic = await describeSelectorMiss(page, googleAuthJoinCtaSelectors, 0, 'join CTA', null);
+      assert.match(diagnostic, /pathname=\/meet\/<room> meetLobbyUrl=true/);
+      for (const secret of ['abc-defg-hij', 'secret', 'do-not-log', 'authuser']) assert.ok(!diagnostic.includes(secret));
+    }
+    console.log('PASS production /meet/<room> route is a lobby; CTA resolves; query and code stay redacted');
+
+    for (const url of [
+      'https://meet.google.com/landing',
+      'https://meet.google.com.evil.invalid/abc-defg-hij',
+      'https://meet.google.com/abc-defg-hij/extra',
+    ]) {
+      await page.goto(url);
+      await page.setContent('<button>Join now</button>');
+      assert.equal(isMeetLobbyUrl(page), false);
+      await assert.rejects(waitForLobbyCta(page, googleAuthJoinCtaSelectors, 0, 'join CTA'));
+    }
+    console.log('PASS guards unchanged: landing/foreign/deeper routes blocked');
+    await page.goto('https://accounts.google.com/v3/signin/confirmidentifier?secret=do-not-log');
+    await page.setContent('<button jsname="login"><span>Join now</span></button>');
+    await assert.rejects(waitForLobbyCta(page, googleAuthJoinCtaSelectors, 0, 'join CTA'),
+      (error: any) => error.outcome === 'auth_session_missing' && !error.message.includes('secret'));
+    console.log('PASS guards unchanged: noncanonical/foreign URLs blocked; Accounts typed auth failure');
+  } finally {
+    await browser.close();
+  }
+}
+main().catch(error => { console.error(error); process.exit(1); });
