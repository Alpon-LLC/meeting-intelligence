# Run python3 setup_local.py init to generate real local secrets.
# This file documents settings; do not use literal examples as credentials.
COMPOSE_PROJECT_NAME=meeting-lab
BOT_NAME=Your Name Meeting Bot
STT_MODEL=small
VEXA_BOT_IMAGE=meeting-lab/vexa-bot:0.12.28
VEXA_MEETING_API_IMAGE=meeting-lab/meeting-api:0.12.28
VEXA_GATEWAY_PORT=19056
VEXA_ADMIN_PORT=19058
# DB_PASSWORD, ADMIN_TOKEN, INTERNAL_API_SECRET, STORAGE_SECRET_KEY and STT_TOKEN
# are generated locally by setup_local.py, never supplied by this repository.
